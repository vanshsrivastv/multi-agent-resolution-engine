# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

# Filled in starting Milestone 3 (LLM integration)
# Using Groq (free tier) for now. Get a key at console.groq.com
GROQ_API_KEY=
# ANTHROPIC_API_KEY=

# Filled in starting Milestone 8 (Razorpay integration, test mode)
# From Dashboard > Settings > API Keys (make sure "Test Mode" is on)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Filled in starting Milestone 12 (Slack human-in-the-loop)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL=

# Filled in starting Milestone 13 (LangSmith observability)
# Note: traces may include ticket text (customer email/message) sent to
# LangSmith's cloud service - fine for this portfolio project, but worth
# knowing before pointing this at real customer data.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-ops-engine
